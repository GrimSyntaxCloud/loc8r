extends layout
block content
  .page-top
    a.back-link(href='/location/') <svg class="compat-arrow" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12H4m7-7-7 7 7 7"></path></svg> Back to Starcups
    span.eyebrow FIELD NOTES / PREVIEW
  section.review-layout
    .review-intro
      p.eyebrow HOW WAS YOUR CORNER?
      h1 A little<br><em>local insight.</em>
      p Good coffee? Great wifi? This is what leaving a note for the next visitor could look like.
      aside.demo-callout
        strong Just a sample form.
        p Nothing you type is sent or saved. Please use fictional details. There is no review submission service.
    form.sample-form(aria-label='Non-submitting sample review form' onsubmit='return false')
      p.eyebrow YOUR NOTES ON STARCUPS
      label(for='name') Your name
      input#name(type='text' maxlength='60' autocomplete='off' placeholder='A fictional name')
      label(for='rating') Your rating
      select#rating
        option(value='5') 5 — A new favorite
        option(value='4') 4 — Worth a return
        option(value='3' selected) 3 — A good little stop
        option(value='2') 2 — Room to improve
        option(value='1') 1 — Not for me
      label(for='review') Your review
      textarea#review(rows='5' maxlength='500' placeholder='A few words about this sample location…' aria-describedby='review-limit')
      p#review-limit.small-note Up to 500 characters. This text stays on this page.
      button.button(type='button' disabled) Sample only — not submitted
      a.text-link(href='/location/') Back to the location <svg class="compat-arrow" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14"></path></svg>
