extends layout
block content
  .page-top
    a.back-link(href='/#places') <svg class="compat-arrow" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 12H4m7-7-7 7 7 7"></path></svg> Back to the index
    span.eyebrow LOCATION / 01
  section.location-hero
    .location-summary
      p.eyebrow YOUR NEXT CORNER
      h1 Starcups<span class="title-period">.</span>
      p.address 125 High Street,<br>Reading, RG6 1PS
      .rating-line
        span.stars(aria-label='3 out of 5 stars') ★★★<span>☆☆</span>
        span 2 sample reviews
      p.location-intro Accessible wifi, a place to sit, and a reason to stay for another coffee. Bring a laptop. Find your rhythm.
      ul.tags(aria-label='Facilities')
        li Hot drinks
        li Food
        li Premium wifi
      a.button(href='https://www.openstreetmap.org/?mlat=51.455041&mlon=-0.9690884#map=17/51.455041/-0.9690884' target='_blank' rel='noopener noreferrer') Open map <span aria-hidden="true"><svg class="compat-arrow" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14"></path></svg></span>
      p.small-note Opens OpenStreetMap in a new tab. Sample coordinates.
    .detail-map
      include map
  section.place-details
    .hours-panel
      p.eyebrow PLAN YOUR PAUSE
      h2 The opening<br><em>hours.</em>
      dl.hours
        div
          dt Monday – Friday
          dd 7 am – 7 pm
        div
          dt Saturday
          dd 8 am – 5 pm
        div
          dt Sunday
          dd Closed
      p.small-note Sample opening hours, not live business information.
    .reviews-panel
      .review-heading
        div
          p.eyebrow NOTES FROM THE TABLE
          h2 A few words.
        a.text-link(href='/location/review/new/') Preview a review <svg class="compat-arrow" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 19 19 5M5 5h14v14"></path></svg>
      article.review
        .review-meta
          span.review-avatar(aria-hidden='true') SH
          div
            h3 Simon Holmes
            time(datetime='2017-02-16') 16 February 2017
          span.stars(aria-label='3 out of 5 stars') ★★★<span>☆☆</span>
        p “What a great place.”
      article.review
        .review-meta
          span.review-avatar(aria-hidden='true') CC
          div
            h3 Charlie Chaplin
            time(datetime='2017-02-14') 14 February 2017
          span.stars(aria-label='3 out of 5 stars') ★★★<span>☆☆</span>
        p “It was okay. Coffee wasn't great.”
      p.demo-note Original sample reviews. This demo does not collect or save new reviews.
